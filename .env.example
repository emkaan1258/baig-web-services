# Contact form delivery via EmailJS (https://www.emailjs.com) — all three are required.
# Template variables to create in EmailJS: {{name}} {{email}} {{phone}} {{service}} {{message}}
# Copy this file to .env and fill in YOUR OWN keys, then restart `npm run dev`.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
